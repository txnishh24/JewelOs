{
  "permissions": {
    "deny": [
      "Read(./.env*)",
      "Read(**/*.pem)",
      "Read(**/credentials*)",
      "Edit(./.env*)",
      "Edit(**/*.pem)",
      "Edit(**/credentials*)",
      "Bash(sudo*)",
      "Bash(chmod 777*)",
      "Bash(ssh*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/block-secret-writes.js"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/block-new-module.js"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/js-guard.js"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/review-after-js-edit.js"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "codex@openai-codex": true,
    "frontend-design@anthropic-plugin-directory": true,
    "superpowers@anthropic-plugin-directory": true,
    "playwright@anthropic-plugin-directory": true,
    "code-review-anthropics@anthropic-plugin-directory": true,
    "github@anthropic-plugin-directory": true,
    "claude-code-setup@anthropic-plugin-directory": true,
    "supabase@anthropic-plugin-directory": true,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "agent-sdk-dev@anthropic-plugin-directory": true
  }
}
