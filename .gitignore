# Installed by checks/package.json — reinstall with `npm install` in checks/
checks/node_modules/

# Installed by the root package.json — reinstall with `npm install`
node_modules/

# Playwright e2e suite (tests/e2e/) — output and secrets, never committed
test-results/
playwright-report/
blob-report/
.env.test

# Build handoffs are zipped out of here, never kept in the tree
*.zip

# Cloudflare: staged assets (rebuilt per deploy) and wrangler's local cache —
# neither belongs in the tree; see wrangler.jsonc's comment for why
cf-deploy-stage/
.wrangler/

# backup-store.js output -- default folder is outside the repo (see docs/BACKUP-SETUP.md),
# this only guards against it ever being pointed inside by mistake
jewelos-backups/
store-20*.json

# Raw semgrep scan output (docs/SECURITY-AUDIT-*.md has the triaged findings)
.security-audit/

# OS / editor noise
desktop.ini
Thumbs.db
.DS_Store

# Skill packs synced in by a plugin reload, unrelated to this Supabase+Cloudflare
# project (this repo has no Vercel deploy target)
.agents/skills/deploy-to-vercel/
.agents/skills/vercel-cli-with-tokens/
.agents/skills/vercel-composition-patterns/
.agents/skills/vercel-optimize/
.agents/skills/vercel-react-best-practices/
.agents/skills/vercel-react-native-skills/
.agents/skills/vercel-react-view-transitions/
.agents/skills/web-design-guidelines/
.agents/skills/writing-guidelines/
.claude/skills/deploy-to-vercel/
.claude/skills/vercel-cli-with-tokens/
.claude/skills/vercel-composition-patterns/
.claude/skills/vercel-optimize/
.claude/skills/vercel-react-best-practices/
.claude/skills/vercel-react-native-skills/
.claude/skills/vercel-react-view-transitions/
.claude/skills/web-design-guidelines/
.claude/skills/writing-guidelines/

# Per-machine Claude Code permissions/plugins
.claude/settings.local.json
